<?xml version="1.0" encoding="utf-8"?>
<!-- The brand kit's app icon (app-icon-1024.png) as an adaptive icon. The PNGs in mipmap-<density> are the same
     composition on the kit's rounded tile (favicon.svg's corner radius; ic_launcher_round: on a disc), for tools
     that read an APK's icon (minSdk 31: a phone always uses this file). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
