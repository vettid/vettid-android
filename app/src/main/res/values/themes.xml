<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only (Compose draws everything). Matches the light surface so
         there is no flash before the first frame. -->
    <style name="Theme.VettID" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/vettid_window</item>
        <item name="android:windowSplashScreenBackground">@color/vettid_window</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
    <color name="vettid_window">#FFFFFFFF</color>
    <color name="vettid_launcher_background">#FF14142A</color>
</resources>
