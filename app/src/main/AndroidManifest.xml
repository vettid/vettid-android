<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The relay and the member API (ANDROID-PLAN §5). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The biometric app lock (ANDROID-PLAN D6). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- No backup or export of vault data (ANDROID-PLAN §4): nothing leaves the
         device through Auto Backup or device-to-device transfer. -->
    <application
        android:name=".VettIdApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.VettID"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Sign-in links (MEMBER-API "Auth"): https://account.vettid.org/auth/#t=<token>&e=<email>.
                 Verified as an App Link once account.vettid.org serves assetlinks.json for the
                 release signing key; until then the member pastes the link. The token is only
                 sent after the member confirms the sign-in in the app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="account.vettid.org" android:pathPrefix="/auth/" />
            </intent-filter>
            <!-- Invitation links (VAULT-MESSAGING §6.4, 0.10.2): <relay>/connect#<link> on the invitation's
                 own relay. Verified as an App Link for the relays VettID runs once the relay serves
                 /.well-known/assetlinks.json (a vettid-relay follow-up); the payload inside decides the
                 relay, never the host. Nothing is sent until the member confirms in the app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="relay.vettid.org" android:path="/connect" />
            </intent-filter>
            <!-- The relay page's "Open in VettID" link for any relay, self-hosted ones included: vettid://connect#<link>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vettid" android:host="connect" />
            </intent-filter>
        </activity>
    </application>
</manifest>
