<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The relay and the member API (ANDROID-PLAN §5). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether a network is usable before a request is retried after Doze (TransportRetry). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The biometric app lock (ANDROID-PLAN D6). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- The local "Vault updates" notification (ANDROID-PLAN 0.1.19): asked for once, in context; nothing is pushed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No backup or export of vault data (ANDROID-PLAN §4): nothing leaves the
         device through Auto Backup or device-to-device transfer. -->
    <application
        android:name=".VettIdApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.VettID"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">

        <!-- singleTask: the share sheet starts its target with FLAG_ACTIVITY_NEW_DOCUMENT and MULTIPLE_TASK, which
             would open a second MainActivity (in a task of its own, or in the sharing app's) while the first one
             lives on in the background. One activity, one UI: a shared file or a link reaches the running one
             (onNewIntent), in the app's own task. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The account portal's same-device setup link (VAULT-MESSAGING §11.12.1, MEMBER-API 2.0.0):
                 https://account.vettid.org/vault/enroll/#s=<QR secret>. Verified as an App Link through the
                 account site's assetlinks.json. The app never signs in, so it no longer claims /auth/. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="account.vettid.org" android:pathPrefix="/vault/enroll/" />
            </intent-filter>
            <!-- Invitation links (VAULT-MESSAGING §6.4, 0.10.2): <relay>/connect#<link> on the invitation's
                 own relay. Verified as an App Link for the relays VettID runs once the relay serves
                 /.well-known/assetlinks.json (a vettid-relay follow-up); the payload inside decides the
                 relay, never the host. Nothing is sent until the member confirms in the app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="relay.vettid.org" android:path="/connect" />
            </intent-filter>
            <!-- The relay page's "Open in VettID" link for any relay, self-hosted ones included: vettid://connect#<link>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vettid" android:host="connect" />
            </intent-filter>
            <!-- A canary manifest (VAULT-RELEASES §10.1 step 9, W10-READINESS B5): VettID's tester shares the
                 signed, unpublished served document (pcr-manifest JSON) to the app. It is verified under the
                 pinned manifest keys and installed only after the member confirms; it adds no trust. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>
    </application>
</manifest>
