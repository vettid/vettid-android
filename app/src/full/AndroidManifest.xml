<?xml version="1.0" encoding="utf-8"?>
<!-- The `full` distribution (Google Play, VettID's own releases): what Google push adds to the app's manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Google push (ANDROID-PLAN 0.1.30, Notification modes 4): Firebase Cloud Messaging only, initialised by
             hand from the build's options (README "Google push"); nothing of Firebase starts by itself.
             - No FirebaseInitProvider (no google-services.json to read), no automatic token (auto-init off: the
               token is asked for only when the member chooses Google push), no Analytics, no delivery metrics.
             - The components that receive pushes are enabled only in a build that carries the options
               (vettidFcmEnabled, app/build.gradle.kts): without them no other app can reach them.
             - WorkManager (a wake's longer collect) is not initialised at every start: on first use only
               (VettIdApplication is its Configuration.Provider), which a build without the options never reaches. -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="delivery_metrics_exported_to_big_query_enabled" android:value="false" />
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <service
            android:name="com.vettid.core.push.fcm.VettIdMessagingService"
            android:enabled="${vettidFcmEnabled}" />
        <service
            android:name="com.google.firebase.messaging.FirebaseMessagingService"
            android:enabled="${vettidFcmEnabled}"
            tools:ignore="MissingClass" />
        <receiver
            android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver"
            android:enabled="${vettidFcmEnabled}"
            tools:ignore="MissingClass" />
    </application>
</manifest>
