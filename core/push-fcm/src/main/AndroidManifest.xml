<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Whether Google Play services are on the phone (FcmPushProvider): package visibility since Android 11. -->
    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <application>
        <!-- Google push wakes (ANDROID-PLAN 0.1.30, Notification modes 4; PUSH-GATEWAY §6): a data message without
             content. Not exported: only Firebase's own receiver hands messages to it. The app's manifest enables it
             only in a build that carries the Firebase options. -->
        <service
            android:name="com.vettid.core.push.fcm.VettIdMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
