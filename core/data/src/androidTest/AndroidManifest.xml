<?xml version="1.0" encoding="utf-8"?>
<!-- The instrumented tests talk to the local dev stack through adb reverse
     (127.0.0.1 on the phone, plain HTTP): test APK only, never the app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:networkSecurityConfig="@xml/devstack_network_security" />
</manifest>
