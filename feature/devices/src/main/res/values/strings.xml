    <string name="pair_try_again">Try again</string>
    <string name="pair_check_now">Check now</string>

    <!-- Step 2: compare. %1$s is the six digits in two groups of three ("123 456"). -->
    <string name="pair_compare_title">Compare the code</string>
    <string name="pair_compare_body">Does the agent show %1$s? Approve only if the codes match.</string>
    <string name="pair_calls_itself">It calls itself %1$s.</string>
    <string name="pair_calls_itself_note">The code proves this phone talks to the agent you just gave the code to. The name is only what the agent says about itself.</string>
    <string name="pair_codes_match">The codes match</string>
    <string name="pair_codes_differ">They don\'t match</string>
    <!-- ("only Reject"): a pairing that is not an agent's, or whose code is not six digits. -->
    <string name="pair_reject">Reject</string>
    <string name="pair_cannot_compare">This phone can\'t show a code to compare for this pairing, so it can\'t be approved. Reject it.</string>
    <string name="pair_rejected_title">Pairing rejected</string>
    <string name="pair_rejected_body">The agent is told it was rejected. If you did not expect a code, someone else may have the pairing code; it no longer works.</string>
    <!-- The rejection could not be sent to the vault: nothing is paired, and it ends by itself. -->
    <string name="pair_rejected_unsent">Nothing is paired. Your vault could not be told, so the pairing ends by itself within 10 minutes. If you did not expect a code, someone else may have the pairing code.</string>
    <string name="pair_done">Done</string>
    <!-- The feed item after the phone lost the code (the process ended since). -->
    <string name="pair_lost_title">A device asks to pair</string>
    <string name="pair_lost_body">This pairing can\'t be checked on this phone any more. Let it expire: it ends by itself within 10 minutes and nothing is paired. If you want to pair, start again.</string>

