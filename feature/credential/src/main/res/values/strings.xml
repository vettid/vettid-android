    <string name="credential_rotate_title">Rotate your credential key</string>
    <string name="credential_rotate_body">Your vault makes a new credential key, re-keys every critical item and rotates its own identity keys. Connections that know your key receive a signed rotation statement. Every older copy of your credential stops working.</string>
    <string name="credential_rotate_submit">Rotate now</string>
    <string name="credential_rotate_done">Your credential key was rotated.</string>

    <string name="credential_alarm_banner">Your credential was presented by another device</string>
    <string name="credential_alarm_review">Review</string>
    <string name="credential_alarm_card_title">Credential alert</string>
    <string name="credential_alarm_card_frozen">Another copy of your credential was presented. Credential use is frozen until you answer.</string>
    <string name="credential_alarm_card_rotate">Rotate your credential to end the alert.</string>
    <string name="credential_alarm_title">Was that you?</string>
    <string name="credential_alarm_body">At %1$s, %2$s presented a copy of your Protean Credential. Your vault refused it and froze credential use. Messaging, connections and your other items keep working.</string>
    <string name="credential_alarm_presenter_holder">this phone\'s session</string>
    <string name="credential_alarm_presenter_other">another device</string>
    <string name="credential_alarm_presenter_unknown">a device</string>
    <string name="credential_alarm_mine">That was me</string>
    <string name="credential_alarm_mine_body">For example, you restored this phone from a backup. A rotation still follows, so that no second copy stays alive.</string>
    <string name="credential_alarm_not_mine">That was not me</string>
    <string name="credential_alarm_confirm_mine_title">Confirm: that was you?</string>
    <string name="credential_alarm_confirm_not_mine_title">Confirm: that was not you?</string>
    <string name="credential_alarm_confirm_body">Either way, you rotate your credential next. Every other copy stops working.</string>
    <string name="credential_alarm_confirm">Confirm</string>
    <string name="credential_alarm_rotate_title">Rotate your credential</string>
    <string name="credential_alarm_rotate_body">Enter your credential password to make a new credential key. Every other copy, including the one presented, stops working.</string>
    <string name="credential_alarm_not_mine_advice_title">Someone may have your credential</string>
    <string name="credential_alarm_not_mine_advice">After the rotation, change your credential password and your vault PIN. If this phone is lost or compromised, start a recovery on the account site.</string>
    <string name="credential_alarm_resolved">The alert is resolved. Your credential works again.</string>
