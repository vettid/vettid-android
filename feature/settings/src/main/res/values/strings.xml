    <!-- Recovery -->
    <string name="settings_recovery_title">Recovery</string>
    <string name="settings_recovery_body">If you lose this phone, start a recovery on the account site. Your vault locks at once; after 24 hours the site shows a code that a new phone scans, and with your PIN and credential password the new phone takes over. This phone is then signed out of the vault. While you still have this phone, use Move to a new phone instead: no waiting.</string>
