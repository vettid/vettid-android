    <!-- Direct transfer, the old phone (VAULT-MESSAGING §6.7.1) -->
    <string name="settings_transfer_title">Move to a new phone</string>
    <string name="settings_transfer_body">Move your vault, your credential and your connections to a new phone. This phone then erases VettID and keeps nothing of it.</string>
    <string name="settings_transfer_steps_title">How it works</string>
    <string name="settings_transfer_steps_body">1. On the new phone, install VettID, choose Move from my old phone and sign in to your account.
2. Show the code here and scan it with the new phone.
3. Check that both phones show the same 6 digits, then approve here with your vault PIN and credential password.</string>
    <string name="settings_transfer_lost">Lost your old phone instead? Start a recovery on the account site.</string>
    <string name="settings_transfer_start">Show the code</string>
    <string name="settings_transfer_show_title">Scan this code with your new phone</string>
    <string name="settings_transfer_show_body">On the new phone, choose Move from my old phone, then scan. Only your new phone should see this code.</string>
    <string name="settings_transfer_qr_cd">Transfer code for your new phone</string>
    <string name="settings_transfer_expires">Valid for %1$s more</string>
    <string name="settings_transfer_link_label">Or paste this code on the new phone</string>
    <string name="settings_transfer_copy">Copy</string>
    <string name="settings_transfer_copied">Copied</string>
    <string name="settings_transfer_waiting">Waiting for your new phone</string>
    <string name="settings_transfer_cancel">Cancel the transfer</string>
    <string name="settings_transfer_compare_title">Compare the code</string>
    <string name="settings_transfer_compare_body">%1$s wants to take over your vault. Continue only if it shows the same code.</string>
    <string name="settings_transfer_match">The codes match</string>
    <string name="settings_transfer_reject">Reject</string>
    <string name="settings_transfer_reject_title">Reject the transfer?</string>
    <string name="settings_transfer_reject_body">Nothing changes: your vault stays on this phone. The new phone is told it was rejected.</string>
    <string name="settings_transfer_approve_title">Approve the move</string>
    <string name="settings_transfer_approve_body">Your vault checks your PIN and your credential password, then hands the vault to %1$s. This phone then erases VettID and returns to the welcome screen, as if freshly installed.</string>
    <string name="settings_transfer_pin">Vault PIN</string>
    <string name="settings_transfer_password">Credential password</string>
    <string name="settings_transfer_approve">Move my vault</string>
    <string name="settings_transfer_approve_confirm_title">Move your vault to %1$s?</string>
    <string name="settings_transfer_approve_confirm_body">This phone will no longer hold your vault or your credential, and VettID erases everything it kept here. You cannot undo this from here.</string>
